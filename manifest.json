{
  "manifest_version": 3,
  "name": "SmartOLT — Control de ONUs",
  "version": "3.0.10",
  "description": "Captura el CSV de SmartOLT, muestra ONUs y cajas y prepara el texto para Telegram. Permite descargar o cargar el CSV manualmente.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartOLT — Control de ONUs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.smartolt.com/*",
    "file:///*"
  ]
}
