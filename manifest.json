{
  "manifest_version": 3,
  "name": "SmartOLT — Control de ONUs",
  "version": "3.1.0",
  "description": "Captura el CSV de SmartOLT, muestra ONUs y cajas y prepara el texto para Telegram. Permite descargar o cargar el CSV manualmente.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartOLT — Control de ONUs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.smartolt.com/onu/unconfigured*"],
      "css": ["unconfigured.css"],
      "js": ["shared.js", "unconfigured.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.smartolt.com/onu/view/*"],
      "css": ["onu-view.css"],
      "js": ["shared.js", "onu-view.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.smartolt.com/*",
    "file:///*"
  ]
}
